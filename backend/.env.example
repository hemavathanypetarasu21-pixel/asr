# Application
APP_NAME=ASR App
APP_VERSION=1.0.0
DEBUG=true
FRONTEND_URL=http://localhost:3000

# Server (python server.py)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=asr

# Supabase auth: tokens are verified with <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Uploads and listing
MAX_UPLOAD_MB=250
RECORDINGS_MAX_PAGE_SIZE=50
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg

# Dialect detection: Whisper's Malay ("ms"/"id") vs Tamil ("ta") language probabilities
# Minimum combined Malay + Tamil probability needed to report a dialect
DIALECT_DETECTION_MIN_CONFIDENCE=0.15
# Minimum normalised gap between Malay and Tamil probabilities
DIALECT_DETECTION_MIN_MARGIN=0.1
# Number of 30-second windows sampled across the recording
DIALECT_DETECTION_MAX_WINDOWS=4

# Translation (Gemini, https://aistudio.google.com/apikey)
# Fallback key; users can save their own key in Settings. Leave empty to require a per-user key.
GEMINI_API_KEY=
GEMINI_TEMPERATURE=0.2
GEMINI_MODEL_CACHE_SECONDS=600

# Encrypts user API keys stored in MongoDB. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Dropdown options (JSON lists of {"id", "label"}).
# Translation models are filtered to those the user's Gemini key can actually use.
RECOGNITION_MODELS=[{"id":"tiny","label":"Whisper tiny (fast)"},{"id":"medium","label":"Whisper medium (accurate)"}]
TRANSLATION_MODELS=[{"id":"gemini-3.5-flash-lite","label":"Gemini 3.5 Flash-Lite"},{"id":"gemini-3.8-flash","label":"Gemini 3.8 Flash"},{"id":"gemini-3.5-flash","label":"Gemini 3.5 Flash"},{"id":"gemini-3.1-pro-preview","label":"Gemini 3.1 Pro (preview)"}]
